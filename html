      resetBillForm();
      switchTab('dashboard');
    }

    function resetBillForm() {
      document.getElementById('monthly-bill-form').reset();
      document.getElementById('entry-id').value = '';
      document.getElementById('bill-form-title').innerText = "Enter Monthly Bill";
      document.getElementById('bill-unit-rate').value = state.settings.defaultUnitRate;
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('bill-month').value = today.slice(0, 7);
      document.getElementById('bill-paid-date').value = today;
      calculateBillTotals();
