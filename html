    function populateBillFormForEdit(bill) {
      document.getElementById('entry-id').value = bill.id;
      document.getElementById('bill-form-title').innerText = "Edit Monthly Bill";
      document.getElementById('bill-tenant-select').value = bill.tenantId;
      document.getElementById('bill-month').value = bill.month;
      document.getElementById('bill-rent').value = bill.rent;
      document.getElementById('bill-maintenance').value = bill.maintenance || 0;
      document.getElementById('bill-prev-meter').value = bill.prevMeter;
      document.getElementById('bill-curr-meter').value = bill.currMeter;
      document.getElementById('bill-unit-rate').value = bill.unitRate || state.settings.defaultUnitRate;
      
      const statusRadios = document.getElementsByName('payment-status');
      for (const r of statusRadios) {
        r.checked = (r.value === bill.status);
      }
      
      document.getElementById('bill-paid-date').value = bill.paidDate || new Date().toISOString().split('T')[0];
      document.getElementById('bill-paid-mode').value = bill.paymentMode || 'Cash';
      document.getElementById('bill-notes').value = bill.notes || '';

      calculateBillTotals();
      togglePaymentFields();
    }

