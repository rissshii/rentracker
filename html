    function toggleBillStatus(billId) {
      const bill = state.bills.find(b => b.id === billId);
      if (!bill) return;

      if (bill.status === 'Paid') {
        bill.status = 'Pending';
        bill.paidDate = '';
        showToast("Marked as Pending", "info");
      } else {
        bill.status = 'Paid';
        bill.paidDate = new Date().toISOString().split('T')[0];
        if (!bill.paymentMode) bill.paymentMode = 'Cash';
        showToast("Marked as Paid!", "success");
      }

      saveAllToStorage();
      renderDashboard();
      renderHistoryTable();
    }

    function renderHistoryTable() {
      const tenantFilter = document.getElementById('history-tenant-filter')?.value || 'ALL';
      const statusFilter = document.getElementById('history-status-filter')?.value || 'ALL';
      const searchTxt = (document.getElementById('history-search')?.value || '').toLowerCase().trim();
      const currency = state.settings.currency || '₹';

      const tbody = document.getElementById('history-table-tbody');
      const emptyDiv = document.getElementById('history-empty');
      tbody.innerHTML = '';

      let filtered = state.bills.filter(b => {
        if (tenantFilter !== 'ALL' && b.tenantId !== tenantFilter) return false;
        if (statusFilter !== 'ALL' && b.status !== statusFilter) return false;

        if (searchTxt) {
          const tenant = state.tenants.find(t => t.id === b.tenantId);
          const tenantStr = tenant ? `${tenant.name} ${tenant.room}`.toLowerCase() : '';
          const notesStr = (b.notes || '').toLowerCase();
          const monthStr = b.month.toLowerCase();
          if (!tenantStr.includes(searchTxt) && !notesStr.includes(searchTxt) && !monthStr.includes(searchTxt)) {
            return false;
          }
        }
        return true;
      });

      // Sort newest month first
      filtered.sort((a, b) => (b.month > a.month ? 1 : -1));

      if (filtered.length === 0) {
        emptyDiv.classList.remove('hidden');
        return;
