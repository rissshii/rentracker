<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mom's Rent & Bill Book</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Font Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
            }
          }
        }
      }
    }
  </script>

  <style>
    @media print {
      body * {
        visibility: hidden;
      }
      #print-receipt-section, #print-receipt-section * {
        visibility: visible;
      }
      #print-receipt-section {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 20px;
        box-shadow: none;
      }
      .no-print {
        display: none !important;
      }
    }
    /* Smooth Transitions */
    .tab-btn.active {
      background-color: #16a34a;
      color: #ffffff;
      box-shadow: 0 4px 6px -1px rgba(22, 163, 74, 0.3);
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen font-sans antialiased flex flex-col">

  <!-- Floating Toast Notification System -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Confirmation Modal (No alerts/confirms) -->
  <div id="confirm-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 text-center transform transition-all">
      <div class="w-14 h-14 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <h3 id="confirm-title" class="text-xl font-bold text-slate-800 mb-2">Are you sure?</h3>
      <p id="confirm-message" class="text-slate-600 text-sm mb-6">This action cannot be undone.</p>
      <div class="flex gap-3 justify-center">
        <button id="confirm-cancel-btn" class="px-5 py-2.5 rounded-xl border border-slate-300 font-semibold text-slate-700 hover:bg-slate-100 transition">Cancel</button>
        <button id="confirm-ok-btn" class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 font-semibold text-white shadow-md transition">Yes, Delete</button>
      </div>
    </div>
  </div>

  <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white text-xl shadow-md shadow-emerald-200">
          <i class="fa-solid fa-house-chimney-user"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold text-slate-900 leading-tight">Mom's Rent & Bill Book</h1>
          <p class="text-xs text-slate-500 font-medium">Simple Tenant, Rent & Electricity Ledger</p>
        </div>
      </div>

      <!-- Quick Action Right Header -->
      <div class="flex items-center space-x-2">
        <button onclick="switchTab('record')" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition shadow-sm">
          <i class="fa-solid fa-plus"></i>
          <span>New Monthly Bill</span>
        </button>
        <button onclick="switchTab('tenants')" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-slate-100 text-slate-700 font-medium text-sm hover:bg-slate-200 transition">
          <i class="fa-solid fa-user-plus"></i>
          <span class="hidden sm:inline">Add Tenant</span>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex space-x-2 overflow-x-auto py-2 border-t border-slate-100 text-sm font-medium">
      <button onclick="switchTab('dashboard')" id="tab-dashboard" class="tab-btn active px-4 py-2 rounded-xl transition flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-chart-pie"></i> Dashboard
      </button>
      <button onclick="switchTab('record')" id="tab-record" class="tab-btn px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-file-invoice-dollar"></i> Add Monthly Bill
      </button>
      <button onclick="switchTab('history')" id="tab-history" class="tab-btn px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-receipt"></i> All Bills & Receipts
      </button>
      <button onclick="switchTab('tenants')" id="tab-tenants" class="tab-btn px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-users"></i> Tenants List
      </button>
      <button onclick="switchTab('settings')" id="tab-settings" class="tab-btn px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-gear"></i> Settings & Backup
      </button>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 w-full flex-grow">

    <!-- ==============================================
         TAB 1: DASHBOARD & MONTHLY OVERVIEW
         ============================================== -->
    <section id="view-dashboard" class="space-y-6">
      
      <!-- Quick Filter Bar -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Viewing Month</span>
          <div class="flex items-center gap-2 mt-1">
            <input type="month" id="dashboard-month-filter" onchange="renderDashboard()" class="border border-slate-300 rounded-xl px-3 py-1.5 font-semibold text-slate-800 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <button onclick="setDashboardCurrentMonth()" class="text-xs text-emerald-700 bg-emerald-50 px-2.5 py-1.5 rounded-lg hover:bg-emerald-100 font-medium">This Month</button>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm text-slate-600">Total Tenants: <strong id="dash-tenant-count" class="text-slate-900 text-base">0</strong></span>
        </div>
      </div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Expected Total -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Billed</p>
              <h3 id="stat-total-billed" class="text-2xl font-bold text-slate-900 mt-1">₹0</h3>
              <p class="text-xs text-slate-500 mt-1">Rent + Electricity combined</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-coins"></i>
            </div>
          </div>
        </div>

        <!-- Received / Paid -->
        <div class="bg-white p-5 rounded-2xl border border-emerald-100 bg-emerald-50/20 shadow-sm relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-semibold uppercase text-emerald-700 tracking-wider">Total Received</p>
              <h3 id="stat-total-received" class="text-2xl font-bold text-emerald-700 mt-1">₹0</h3>
              <p id="stat-paid-count" class="text-xs text-emerald-600 font-medium mt-1">0 bills paid</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-circle-check"></i>
            </div>
          </div>
        </div>

        <!-- Pending / Unpaid -->
        <div class="bg-white p-5 rounded-2xl border border-amber-100 bg-amber-50/20 shadow-sm relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-semibold uppercase text-amber-700 tracking-wider">Pending Balance</p>
              <h3 id="stat-total-pending" class="text-2xl font-bold text-amber-600 mt-1">₹0</h3>
              <p id="stat-pending-count" class="text-xs text-amber-600 font-medium mt-1">0 pending</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
          </div>
        </div>

        <!-- Electricity Units Total -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Power Used</p>
              <h3 id="stat-total-units" class="text-2xl font-bold text-amber-700 mt-1">0 <span class="text-sm font-normal text-slate-600">units</span></h3>
              <p id="stat-power-amt" class="text-xs text-slate-500 mt-1">₹0 electricity bill</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-bolt"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Month Breakdown Table for Each Tenant -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Tenant Status For Selected Month</h2>
            <p class="text-xs text-slate-500">Overview of who has paid and whose bill is pending</p>
          </div>
          <button onclick="switchTab('record')" class="text-sm font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3.5 py-1.5 rounded-xl transition">
            + Record Bill
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 font-medium text-xs uppercase border-b border-slate-100">
              <tr>
                <th class="px-5 py-3.5">Room & Tenant</th>
                <th class="px-4 py-3.5">Base Rent</th>
                <th class="px-4 py-3.5">Electricity (Units)</th>
                <th class="px-4 py-3.5">Total Bill</th>
                <th class="px-4 py-3.5">Status</th>
                <th class="px-5 py-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="dashboard-tenants-tbody" class="divide-y divide-slate-100">
              <!-- Dynamically Populated -->
            </tbody>
          </table>
        </div>
        <div id="dash-empty-message" class="hidden p-8 text-center text-slate-500">
          <i class="fa-regular fa-folder-open text-4xl mb-2 text-slate-300"></i>
          <p>No records found for this month.</p>
        </div>
      </div>
    </section>

    <!-- ==============================================
         TAB 2: ADD / EDIT MONTHLY BILL ENTRY
         ============================================== -->
    <section id="view-record" class="hidden max-w-3xl mx-auto">
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <div class="border-b border-slate-100 pb-5 mb-6 flex items-center justify-between">
          <div>
            <h2 class="text-2xl font-bold text-slate-900" id="bill-form-title">Enter Monthly Bill</h2>
            <p class="text-sm text-slate-500">Calculate electricity meter reading and rent for this month</p>
          </div>
          <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">Step-by-Step Easy</span>
        </div>

        <form id="monthly-bill-form" onsubmit="saveBillEntry(event)" class="space-y-6">
          <input type="hidden" id="entry-id" value="">

          <!-- Row 1: Tenant & Month Selection -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                1. Select Tenant <span class="text-rose-500">*</span>
              </label>
              <select id="bill-tenant-select" required onchange="onTenantSelectionChange()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none">
                <option value="">-- Choose Tenant / Room --</option>
              </select>
              <p class="text-xs text-slate-400 mt-1.5">Can't find tenant? Add them in "Tenants List" tab first.</p>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                2. Billing Month & Year <span class="text-rose-500">*</span>
              </label>
              <input type="month" id="bill-month" required onchange="onBillMonthChange()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none">
            </div>
          </div>

          <!-- Row 2: Rent and Electricity Rate Setting -->
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-4">
            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
              <i class="fa-solid fa-money-bill-wave text-emerald-600"></i> Monthly Base Rent
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Room Base Rent (<span class="currency-symbol">₹</span>)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-3 text-slate-400 font-bold currency-symbol">₹</span>
                  <input type="number" id="bill-rent" step="any" min="0" required oninput="calculateBillTotals()" class="w-full pl-8 pr-4 py-2.5 bg-white border border-slate-300 rounded-xl font-bold text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="0">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Water / Maintenance / Other (<span class="currency-symbol">₹</span>)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-3 text-slate-400 font-bold currency-symbol">₹</span>
                  <input type="number" id="bill-maintenance" step="any" min="0" value="0" oninput="calculateBillTotals()" class="w-full pl-8 pr-4 py-2.5 bg-white border border-slate-300 rounded-xl font-semibold text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="0">
                </div>
              </div>
            </div>
          </div>

          <!-- Row 3: Electricity Meter Calculator Card -->
          <div class="p-5 rounded-2xl bg-amber-50/50 border border-amber-200/80 space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                <i class="fa-solid fa-bolt text-amber-500"></i> Electricity Calculation (Sub-meter)
              </h3>
              <div class="flex items-center gap-2 text-xs">
                <span class="text-slate-600 font-medium">Rate / Unit:</span>
                <div class="flex items-center">
                  <span class="currency-symbol font-bold mr-1 text-slate-700">₹</span>
                  <input type="number" id="bill-unit-rate" step="0.1" min="0" oninput="calculateBillTotals()" class="w-16 bg-white border border-slate-300 rounded-lg px-2 py-1 font-bold text-slate-800 text-center focus:ring-2 focus:ring-amber-500 focus:outline-none">
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Previous Meter Reading</label>
                <input type="number" id="bill-prev-meter" step="any" min="0" required oninput="calculateBillTotals()" class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl font-semibold text-slate-800 focus:ring-2 focus:ring-amber-500 focus:outline-none" placeholder="e.g. 1420">
                <p id="prev-reading-hint" class="text-[11px] text-slate-500 mt-1">Auto-fetched from last bill</p>
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Current Meter Reading</label>
                <input type="number" id="bill-curr-meter" step="any" min="0" required oninput="calculateBillTotals()" class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl font-semibold text-slate-800 focus:ring-2 focus:ring-amber-500 focus:outline-none" placeholder="e.g. 1540">
                <p class="text-[11px] text-slate-500 mt-1">Read from meter</p>
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Units Consumed</label>
                <div class="px-3.5 py-2.5 bg-amber-100/60 border border-amber-200 rounded-xl font-bold text-amber-900 flex justify-between items-center">
                  <span id="bill-calc-units">0</span>
                  <span class="text-xs font-semibold text-amber-700">Units</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">(Current - Previous)</p>
              </div>
            </div>

            <!-- Total Electricity Bill Display -->
            <div class="bg-white p-3 rounded-xl border border-amber-200 flex justify-between items-center text-sm">
              <span class="text-slate-600 font-medium">Calculated Power Bill:</span>
              <span class="font-bold text-amber-700 text-base" id="bill-electricity-total">₹0</span>
            </div>
          </div>

          <!-- Row 4: Total Amount & Payment Status -->
          <div class="bg-emerald-50 rounded-2xl p-5 border border-emerald-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="text-xs font-bold text-emerald-800 uppercase tracking-wide">Total Amount Payable</span>
                <div class="text-3xl font-extrabold text-emerald-800 mt-1" id="bill-grand-total">₹0</div>
                <p class="text-xs text-emerald-700 mt-0.5">Rent + Electricity + Maintenance</p>
              </div>

              <div class="space-y-2">
                <label class="block text-xs font-bold text-emerald-900 uppercase">Payment Status</label>
                <div class="flex items-center gap-3">
                  <label class="flex items-center gap-2 bg-white px-3.5 py-2 rounded-xl border border-emerald-300 cursor-pointer text-sm font-semibold text-emerald-900 shadow-xs">
                    <input type="radio" name="payment-status" value="Paid" checked onchange="togglePaymentFields()">
                    <span><i class="fa-solid fa-check text-emerald-600 mr-1"></i> Paid</span>
                  </label>
                  <label class="flex items-center gap-2 bg-white px-3.5 py-2 rounded-xl border border-slate-300 cursor-pointer text-sm font-semibold text-amber-700 shadow-xs">
                    <input type="radio" name="payment-status" value="Pending" onchange="togglePaymentFields()">
                    <span><i class="fa-solid fa-clock text-amber-600 mr-1"></i> Pending</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Payment Details (Date & Mode) -->
            <div id="payment-details-row" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 pt-4 border-t border-emerald-200">
              <div>
                <label class="block text-xs font-medium text-emerald-900 mb-1">Payment Date</label>
                <input type="date" id="bill-paid-date" class="w-full bg-white border border-emerald-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-emerald-900 mb-1">Payment Mode</label>
                <select id="bill-paid-mode" class="w-full bg-white border border-emerald-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none font-medium">
                  <option value="Cash">Cash</option>
                  <option value="Google Pay / UPI">Google Pay / PhonePe / UPI</option>
                  <option value="Bank Transfer">Bank Transfer / NEFT</option>
                  <option value="Cheque">Cheque</option>
                </select>
              </div>
            </div>

            <div class="mt-3">
              <label class="block text-xs font-medium text-emerald-900 mb-1">Optional Notes</label>
              <input type="text" id="bill-notes" placeholder="e.g. Paid in 2 parts, or ₹500 advance kept" class="w-full bg-white border border-emerald-300 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none">
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex items-center justify-end gap-3 pt-2">
            <button type="button" onclick="cancelBillEdit()" class="px-5 py-3 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 transition">
              Cancel
            </button>
            <button type="submit" class="px-7 py-3 rounded-xl bg-emerald-600 text-white font-bold hover:bg-emerald-700 transition shadow-lg shadow-emerald-200 flex items-center gap-2">
              <i class="fa-solid fa-floppy-disk"></i>
              <span>Save Record</span>
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- ==============================================
         TAB 3: ALL BILLS & RECEIPTS (HISTORY)
         ============================================== -->
    <section id="view-history" class="hidden space-y-5">
      <!-- Search & Filters -->
      <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <!-- Filter by Tenant -->
          <select id="history-tenant-filter" onchange="renderHistoryTable()" class="bg-slate-50 border border-slate-300 text-slate-700 text-sm font-medium rounded-xl px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
            <option value="ALL">All Tenants</option>
          </select>

          <!-- Filter by Status -->
          <select id="history-status-filter" onchange="renderHistoryTable()" class="bg-slate-50 border border-slate-300 text-slate-700 text-sm font-medium rounded-xl px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
            <option value="ALL">All Status</option>
            <option value="Paid">Paid Only</option>
            <option value="Pending">Pending Only</option>
          </select>

          <!-- Search Box -->
          <div class="relative flex-grow sm:w-60">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
