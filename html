    function onTenantSelectionChange() {
      const tenantId = document.getElementById('bill-tenant-select').value;
      if (!tenantId) return;

      const tenant = state.tenants.find(t => t.id === tenantId);
      if (!tenant) return;

      // Auto-fill rent
      document.getElementById('bill-rent').value = tenant.rent || 0;

      // Auto-fetch previous meter reading:
      // Look for the latest bill of this tenant, or default to initial tenant meter reading
      const tenantBills = state.bills.filter(b => b.tenantId === tenantId)
        .sort((a, b) => (b.month > a.month ? 1 : -1));

      if (tenantBills.length > 0) {
        document.getElementById('bill-prev-meter').value = tenantBills[0].currMeter || 0;
        document.getElementById('prev-reading-hint').innerText = `Auto-fetched from ${tenantBills[0].month} bill (${tenantBills[0].currMeter})`;
      } else {
        document.getElementById('bill-prev-meter').value = tenant.meterReading || 0;
        document.getElementById('prev-reading-hint').innerText = `Initial starting meter reading (${tenant.meterReading || 0})`;
      }

      calculateBillTotals();
    }

    function onBillMonthChange() {
      // If user switches month, check if there's an existing bill for this tenant & month to load
      const tenantId = document.getElementById('bill-tenant-select').value;
      const month = document.getElementById('bill-month').value;
      if (tenantId && month) {
        const existing = state.bills.find(b => b.tenantId === tenantId && b.month === month);
        if (existing) {
          populateBillFormForEdit(existing);
        }
      }
    }

    function calculateBillTotals() {
      const rent = parseFloat(document.getElementById('bill-rent').value) || 0;
      const maintenance = parseFloat(document.getElementById('bill-maintenance').value) || 0;
      const prevMeter = parseFloat(document.getElementById('bill-prev-meter').value) || 0;
      const currMeter = parseFloat(document.getElementById('bill-curr-meter').value) || 0;
      const unitRate = parseFloat(document.getElementById('bill-unit-rate').value) || 0;
      const currency = state.settings.currency || '₹';

      // Units calculation (curr - prev, non-negative)
      const units = Math.max(0, currMeter - prevMeter);
      const electricityTotal = Math.round(units * unitRate * 100) / 100;
      const grandTotal = Math.round((rent + maintenance + electricityTotal) * 100) / 100;

      // Update UI displays
      document.getElementById('bill-calc-units').innerText = units;
      document.getElementById('bill-electricity-total').innerText = `${currency}${electricityTotal.toLocaleString()}`;
      document.getElementById('bill-grand-total').innerText = `${currency}${grandTotal.toLocaleString()}`;
    }

    function togglePaymentFields() {
      const isPaid = document.querySelector('input[name="payment-status"]:checked').value === 'Paid';
      const detailsRow = document.getElementById('payment-details-row');
      if (detailsRow) {
        detailsRow.style.opacity = isPaid ? '1' : '0.5';
      }
    }

    function saveBillEntry(e) {
      e.preventDefault();

      const editId = document.getElementById('entry-id').value;
      const tenantId = document.getElementById('bill-tenant-select').value;
      const month = document.getElementById('bill-month').value;

      if (!tenantId) {
        showToast("Please select a tenant", "error");
        return;
      }
      if (!month) {
        showToast("Please choose a billing month", "error");
        return;
      }

      const rent = parseFloat(document.getElementById('bill-rent').value) || 0;
      const maintenance = parseFloat(document.getElementById('bill-maintenance').value) || 0;
      const prevMeter = parseFloat(document.getElementById('bill-prev-meter').value) || 0;
      const currMeter = parseFloat(document.getElementById('bill-curr-meter').value) || 0;
      const unitRate = parseFloat(document.getElementById('bill-unit-rate').value) || 0;

      if (currMeter < prevMeter) {
        showToast("Current meter reading cannot be less than previous!", "warning");
      }

      const units = Math.max(0, currMeter - prevMeter);
      const electricityTotal = Math.round(units * unitRate * 100) / 100;
      const grandTotal = Math.round((rent + maintenance + electricityTotal) * 100) / 100;
      const status = document.querySelector('input[name="payment-status"]:checked').value;
      const paidDate = document.getElementById('bill-paid-date').value;
      const paymentMode = document.getElementById('bill-paid-mode').value;
      const notes = document.getElementById('bill-notes').value.trim();

      if (editId) {
        // Update existing bill
        const idx = state.bills.findIndex(b => b.id === editId);
        if (idx !== -1) {
          state.bills[idx] = {
            ...state.bills[idx],
            tenantId,
            month,
            rent,
            maintenance,
            prevMeter,
            currMeter,
            units,
            unitRate,
            electricityTotal,
            grandTotal,
            status,
            paidDate: status === 'Paid' ? paidDate : '',
            paymentMode: status === 'Paid' ? paymentMode : '',
            notes
          };
          showToast("Bill updated successfully!", "success");
        }
      } else {
        // Check duplicate bill for same tenant & month
        const duplicate = state.bills.find(b => b.tenantId === tenantId && b.month === month);
        if (duplicate) {
          showToast(`A bill for this tenant for ${month} already exists! Updating it instead.`, "info");
          duplicate.rent = rent;
          duplicate.maintenance = maintenance;
          duplicate.prevMeter = prevMeter;
          duplicate.currMeter = currMeter;
          duplicate.units = units;
          duplicate.unitRate = unitRate;
          duplicate.electricityTotal = electricityTotal;
          duplicate.grandTotal = grandTotal;
          duplicate.status = status;
          duplicate.paidDate = status === 'Paid' ? paidDate : '';
          duplicate.paymentMode = status === 'Paid' ? paymentMode : '';
          duplicate.notes = notes;
        } else {
          const newBill = {
            id: 'b_' + Date.now(),
            tenantId,
            month,
            rent,
            maintenance,
            prevMeter,
            currMeter,
            units,
            unitRate,
            electricityTotal,
            grandTotal,
            status,
            paidDate: status === 'Paid' ? paidDate : '',
            paymentMode: status === 'Paid' ? paymentMode : '',
            notes
          };
          state.bills.unshift(newBill);
          showToast("New bill saved successfully!", "success");
        }
      }

      saveAllToStorage();
      resetBillForm();
      switchTab('dashboard');
    }

