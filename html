    function renderDashboard() {
      const monthVal = document.getElementById('dashboard-month-filter')?.value || new Date().toISOString().slice(0, 7);
      const currency = state.settings.currency || '₹';

      // Update tenant count
      document.getElementById('dash-tenant-count').innerText = state.tenants.length;

      // Filter bills for this month
      const monthBills = state.bills.filter(b => b.month === monthVal);

      let totalBilled = 0;
      let totalReceived = 0;
      let totalPending = 0;
      let totalUnits = 0;
      let totalElecAmount = 0;
      let paidCount = 0;
      let pendingCount = 0;

      monthBills.forEach(b => {
        totalBilled += Number(b.grandTotal || 0);
        totalUnits += Number(b.units || 0);
        totalElecAmount += Number(b.electricityTotal || 0);

        if (b.status === 'Paid') {
          totalReceived += Number(b.grandTotal || 0);
          paidCount++;
        } else {
          totalPending += Number(b.grandTotal || 0);
          pendingCount++;
        }
      });

      // Update Stats KPI
      document.getElementById('stat-total-billed').innerText = `${currency}${totalBilled.toLocaleString()}`;
      document.getElementById('stat-total-received').innerText = `${currency}${totalReceived.toLocaleString()}`;
      document.getElementById('stat-paid-count').innerText = `${paidCount} bills paid`;
      
      document.getElementById('stat-total-pending').innerText = `${currency}${totalPending.toLocaleString()}`;
      document.getElementById('stat-pending-count').innerText = `${pendingCount} unpaid/pending`;

      document.getElementById('stat-total-units').innerHTML = `${totalUnits.toLocaleString()} <span class="text-sm font-normal text-slate-600">units</span>`;
      document.getElementById('stat-power-amt').innerText = `${currency}${totalElecAmount.toLocaleString()} electricity bill`;

