          <td class="px-4 py-3.5">
            <div class="font-bold text-slate-800">${escapeHtml(tenant.room)}</div>
            <div class="text-xs text-slate-500">${escapeHtml(tenant.name)}</div>
          </td>
          <td class="px-4 py-3.5 font-semibold text-slate-800">
            ${currency}${Number(bill.rent).toLocaleString()}
          </td>
          <td class="px-4 py-3.5">
            <div class="font-bold text-amber-700">${currency}${Number(bill.electricityTotal).toLocaleString()}</div>
            <div class="text-xs text-slate-500">${bill.units} units (${bill.prevMeter} - ${bill.currMeter})</div>
          </td>
          <td class="px-4 py-3.5">
            <div class="font-bold text-base text-slate-900">${currency}${Number(bill.grandTotal).toLocaleString()}</div>
          </td>
          <td class="px-4 py-3.5 whitespace-nowrap">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold ${isPaid ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
              <i class="fa-solid ${isPaid ? 'fa-check text-emerald-600' : 'fa-clock text-amber-600'}"></i>
              ${isPaid ? 'Paid' : 'Pending'}
            </span>
            ${bill.paidDate ? `<div class="text-[11px] text-slate-400 mt-0.5">${bill.paidDate}</div>` : ''}
          </td>
          <td class="px-4 py-3.5 text-right whitespace-nowrap space-x-1">
            <button onclick="openReceipt('${bill.id}')" title="Receipt & Slip" class="p-2 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition">
