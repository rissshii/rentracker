      document.getElementById('tenant-modal-title').innerText = "Edit Tenant Details";
      document.getElementById('t-room').value = t.room;
      document.getElementById('t-name').value = t.name;
      document.getElementById('t-phone').value = t.phone || '';
      document.getElementById('t-rent').value = t.rent;
      document.getElementById('t-meter').value = t.meterReading || 0;
      document.getElementById('t-start-date').value = t.startDate || '';
      document.getElementById('t-deposit').value = t.deposit || '';

      document.getElementById('tenant-modal').classList.remove('hidden');
      document.getElementById('tenant-modal').classList.add('flex');
    }

    function saveTenant(e) {
      e.preventDefault();
      const id = document.getElementById('tenant-id').value;
      const room = document.getElementById('t-room').value.trim();
      const name = document.getElementById('t-name').value.trim();
      const phone = document.getElementById('t-phone').value.trim();
      const rent = parseFloat(document.getElementById('t-rent').value) || 0;
      const meterReading = parseFloat(document.getElementById('t-meter').value) || 0;
      const startDate = document.getElementById('t-start-date').value;
      const deposit = parseFloat(document.getElementById('t-deposit').value) || 0;

      if (id) {
        // Edit existing
        const idx = state.tenants.findIndex(t => t.id === id);
        if (idx !== -1) {
          state.tenants[idx] = { ...state.tenants[idx], room, name, phone, rent, meterReading, startDate, deposit };
          showToast("Tenant updated!", "success");
        }
      } else {
        // Add new
        const newTenant = {
          id: 't_' + Date.now(),
          room,
          name,
          phone,
          rent,
          meterReading,
          startDate,
          deposit
        };
        state.tenants.push(newTenant);
        showToast("New tenant added successfully!", "success");
      }

      saveAllToStorage();
      closeTenantModal();
      populateTenantDropdowns();
      renderTenants();
      renderDashboard();
    }

    function deleteTenantConfirm(tenantId) {
      const tenant = state.tenants.find(t => t.id === tenantId);
      const name = tenant ? tenant.name : "this tenant";
      
      showConfirmModal(
        `Delete ${name}?`,
        "This will also delete the tenant's profile. (Past bills can remain in history).",
        () => {
          state.tenants = state.tenants.filter(t => t.id !== tenantId);
          saveAllToStorage();
          populateTenantDropdowns();
          renderTenants();
          renderDashboard();
          showToast("Tenant removed", "info");
        }
      );
    }

    function openReceipt(billId) {
      const bill = state.bills.find(b => b.id === billId);
      if (!bill) return;

      const tenant = state.tenants.find(t => t.id === bill.tenantId) || { name: 'Tenant', room: 'Room' };
      const currency = state.settings.currency || '₹';

      state.currentReceiptData = { bill, tenant };

      // Format Month: e.g. 2026-08 -> AUGUST 2026
      const [y, m] = bill.month.split('-');
      const monthDate = new Date(y, parseInt(m, 10) - 1, 1);
      const monthStr = monthDate.toLocaleString('default', { month: 'long', year: 'numeric' }).toUpperCase();

      document.getElementById('receipt-prop-name').innerText = state.settings.propertyName || "Rent & Electricity Slip";
      document.getElementById('receipt-month-display').innerText = `BILLING MONTH: ${monthStr}`;
      document.getElementById('receipt-date-display').innerText = `Slip Generated: ${new Date().toLocaleDateString()}`;

      document.getElementById('receipt-room').innerText = tenant.room;
      document.getElementById('receipt-name').innerText = tenant.name;

      const badge = document.getElementById('receipt-status-badge');
      if (bill.status === 'Paid') {
        badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800";
        badge.innerText = "PAID";
      } else {
        badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800";
        badge.innerText = "PENDING PAYMENT";
      }

      document.getElementById('receipt-rent-val').innerText = `${currency}${Number(bill.rent).toLocaleString()}`;
      document.getElementById('receipt-elec-val').innerText = `${currency}${Number(bill.electricityTotal).toLocaleString()}`;
      document.getElementById('receipt-curr-reading').innerText = bill.currMeter;
      document.getElementById('receipt-prev-reading').innerText = bill.prevMeter;
      document.getElementById('receipt-units-math').innerText = `${bill.units} units @ ${currency}${bill.unitRate}/unit`;

      const extraRow = document.getElementById('receipt-extra-row');
      if (bill.maintenance && Number(bill.maintenance) > 0) {
        extraRow.classList.remove('hidden');
        document.getElementById('receipt-extra-val').innerText = `${currency}${Number(bill.maintenance).toLocaleString()}`;
      } else {
        extraRow.classList.add('hidden');
      }

      document.getElementById('receipt-grand-val').innerText = `${currency}${Number(bill.grandTotal).toLocaleString()}`;
      
      const metaEl = document.getElementById('receipt-pay-meta');
      if (bill.status === 'Paid') {
        metaEl.innerText = `Paid via ${bill.paymentMode || 'Cash'} on ${bill.paidDate || 'today'}`;
      } else {
        metaEl.innerText = `Status: Payment is pending`;
      }

      document.getElementById('receipt-modal').classList.remove('hidden');
      document.getElementById('receipt-modal').classList.add('flex');
    }

    function closeReceiptModal() {
      document.getElementById('receipt-modal').classList.add('hidden');
      document.getElementById('receipt-modal').classList.remove('flex');
    }

    function shareViaWhatsApp() {
      if (!state.currentReceiptData) return;
      const { bill, tenant } = state.currentReceiptData;
      const currency = state.settings.currency || '₹';

      const [y, m] = bill.month.split('-');
      const monthDate = new Date(y, parseInt(m, 10) - 1, 1);
      const monthStr = monthDate.toLocaleString('default', { month: 'long', year: 'numeric' });

      // Generate neat WhatsApp friendly text
      const msg = 
`🏡 *${state.settings.propertyName || 'Rental Receipt'}*
📅 *Bill for: ${monthStr}*
━━━━━━━━━━━━━━━━━
👤 *Tenant:* ${tenant.name} (${tenant.room})
💵 *Base Room Rent:* ${currency}${bill.rent}
⚡ *Electricity Bill:* ${currency}${bill.electricityTotal}
   • Meter Reading: ${bill.prevMeter} to ${bill.currMeter}
   • Units: ${bill.units} units × ${currency}${bill.unitRate}
${bill.maintenance > 0 ? `💧 *Other/Maintenance:* ${currency}${bill.maintenance}\n` : ''}━━━━━━━━━━━━━━━━━
💰 *Total Amount:* ${currency}${bill.grandTotal}
📌 *Status:* ${bill.status === 'Paid' ? `PAID (${bill.paymentMode || 'Cash'})` : 'PENDING'}
━━━━━━━━━━━━━━━━━
Thank you! 🙏`;

      copyToClipboardFallback(msg);
      showToast("Receipt copied! Paste it in WhatsApp chat", "success");
    }

    function copyToClipboardFallback(text) {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      try {
        document.execCommand('copy');
      } catch (err) {
        console.error('Fallback: Oops, unable to copy', err);
      }
      document.body.removeChild(textarea);
    }

    function applySettingsToUI() {
      const curr = state.settings.currency || '₹';
      document.querySelectorAll('.currency-symbol').forEach(el => el.innerText = curr);

      const rateInput = document.getElementById('setting-default-rate');
      if (rateInput) rateInput.value = state.settings.defaultUnitRate || 8;

      const currSelect = document.getElementById('setting-currency');
      if (currSelect) currSelect.value = curr;

      const propInput = document.getElementById('setting-property-name');
      if (propInput) propInput.value = state.settings.propertyName || '';
    }

    function updateSettings() {
      state.settings.currency = document.getElementById('setting-currency').value;
      state.settings.defaultUnitRate = parseFloat(document.getElementById('setting-default-rate').value) || 8;
      state.settings.propertyName = document.getElementById('setting-property-name').value.trim() || "Mom's Rental House";
      
      saveAllToStorage();
      applySettingsToUI();
      renderDashboard();
      renderHistoryTable();
      renderTenants();
      showToast("Settings updated!", "success");
    }

    function exportToCSV() {
      if (state.bills.length === 0) {
        showToast("No bill records to export!", "warning");
        return;
      }

      let csv = "Month,Room,Tenant Name,Base Rent,Prev Meter,Curr Meter,Units,Unit Rate,Electricity Bill,Other Charges,Total Bill,Status,Paid Date,Payment Mode,Notes\n";

      state.bills.forEach(b => {
        const tenant = state.tenants.find(t => t.id === b.tenantId) || { room: 'N/A', name: 'N/A' };
        const row = [
          `"${b.month}"`,
          `"${tenant.room.replace(/"/g, '""')}"`,
          `"${tenant.name.replace(/"/g, '""')}"`,
          b.rent,
          b.prevMeter,
          b.currMeter,
          b.units,
          b.unitRate,
          b.electricityTotal,
          b.maintenance || 0,
          b.grandTotal,
          `"${b.status}"`,
          `"${b.paidDate || ''}"`,
          `"${b.paymentMode || ''}"`,
          `"${(b.notes || '').replace(/"/g, '""')}"`
        ];
        csv += row.join(",") + "\n";
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `rent_and_electricity_records_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("CSV Downloaded!", "success");
    }

    function exportJSONBackup() {
      const dataToSave = {
        version: 1,
        date: new Date().toISOString(),
        tenants: state.tenants,
        bills: state.bills,
        settings: state.settings
      };

      const jsonStr = JSON.stringify(dataToSave, null, 2);
      const blob = new Blob([jsonStr], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `moms_rent_book_backup_${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("Backup saved to your device!", "success");
    }

    function importJSONBackup(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed && parsed.tenants && parsed.bills) {
            state.tenants = parsed.tenants;
            state.bills = parsed.bills;
            if (parsed.settings) state.settings = { ...state.settings, ...parsed.settings };
            
            saveAllToStorage();
            applySettingsToUI();
            populateTenantDropdowns();
            renderDashboard();
            renderHistoryTable();
            renderTenants();
            showToast("Backup restored successfully!", "success");
          } else {
            showToast("Invalid backup file format.", "error");
          }
        } catch (err) {
          console.error(err);
          showToast("Failed to read file.", "error");
        }
      };
      reader.readAsText(file);
      e.target.value = '';
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `pointer-events-auto px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-sm font-semibold text-white transition-all transform duration-300 translate-y-2 opacity-0`;

      if (type === 'success') {
        toast.classList.add('bg-emerald-600');
        toast.innerHTML = `<i class="fa-solid fa-circle-check text-lg"></i> <span>${escapeHtml(message)}</span>`;
      } else if (type === 'error') {
        toast.classList.add('bg-rose-600');
        toast.innerHTML = `<i class="fa-solid fa-circle-xmark text-lg"></i> <span>${escapeHtml(message)}</span>`;
      } else if (type === 'warning') {
        toast.classList.add('bg-amber-600');
        toast.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-lg"></i> <span>${escapeHtml(message)}</span>`;
      } else {
        toast.classList.add('bg-slate-800');
        toast.innerHTML = `<i class="fa-solid fa-info-circle text-lg"></i> <span>${escapeHtml(message)}</span>`;
      }

      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function showConfirmModal(title, message, onConfirm) {
      const modal = document.getElementById('confirm-modal');
      document.getElementById('confirm-title').innerText = title;
      document.getElementById('confirm-message').innerText = message;

      const okBtn = document.getElementById('confirm-ok-btn');
      const cancelBtn = document.getElementById('confirm-cancel-btn');

      const cleanup = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        okBtn.onclick = null;
        cancelBtn.onclick = null;
      };

      okBtn.onclick = () => {
        cleanup();
        if (onConfirm) onConfirm();
      };

      cancelBtn.onclick = cleanup;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function escapeHtml(string) {
      if (!string) return '';
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
