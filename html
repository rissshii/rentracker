  <script>
    /* =========================================================================
       APPLICATION DATA STORE & DEFAULTS
       ========================================================================= */
    const STORAGE_KEY_TENANTS = 'mom_rent_tenants_v1';
    const STORAGE_KEY_BILLS = 'mom_rent_bills_v1';
    const STORAGE_KEY_SETTINGS = 'mom_rent_settings_v1';

    // App state
    let state = {
      tenants: [],
      bills: [],
      settings: {
        currency: '₹',
        defaultUnitRate: 8,
        propertyName: "Mom's Rental House"
      },
      currentTab: 'dashboard',
      currentReceiptData: null
    };

    window.addEventListener('DOMContentLoaded', () => {
      loadDataFromStorage();
      
      // If first time ever, load sample data so mom sees how it works right away!
      if (state.tenants.length === 0 && state.bills.length === 0) {
        initDefaultSampleData();
      }

      // Initialize UI controls
      setDashboardCurrentMonth();
      applySettingsToUI();
      populateTenantDropdowns();
      renderDashboard();
      renderHistoryTable();
      renderTenants();
      
      // Default dates for new forms
      const today = new Date().toISOString().split('T')[0];
      const monthInput = document.getElementById('bill-month');
      if (monthInput) monthInput.value = today.slice(0, 7);
      const paidDateInput = document.getElementById('bill-paid-date');
      if (paidDateInput) paidDateInput.value = today;

      const defaultRateInput = document.getElementById('bill-unit-rate');
      if (defaultRateInput) defaultRateInput.value = state.settings.defaultUnitRate;
    });

    /* =========================================================================
       STORAGE & BACKUP FUNCTIONS
       ========================================================================= */
    function loadDataFromStorage() {
      try {
        const storedTenants = localStorage.getItem(STORAGE_KEY_TENANTS);
        const storedBills = localStorage.getItem(STORAGE_KEY_BILLS);
        const storedSettings = localStorage.getItem(STORAGE_KEY_SETTINGS);

        if (storedTenants) state.tenants = JSON.parse(storedTenants);
        if (storedBills) state.bills = JSON.parse(storedBills);
        if (storedSettings) state.settings = { ...state.settings, ...JSON.parse(storedSettings) };
      } catch (e) {
        console.error("Storage load error:", e);
      }
    }

    function saveAllToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_TENANTS, JSON.stringify(state.tenants));
        localStorage.setItem(STORAGE_KEY_BILLS, JSON.stringify(state.bills));
        localStorage.setItem(STORAGE_KEY_SETTINGS, JSON.stringify(state.settings));
      } catch (e) {
        console.error("Storage save error:", e);
        showToast("Error saving data locally", "error");
      }
    }

    function initDefaultSampleData() {
      state.settings = {
        currency: '₹',
        defaultUnitRate: 8,
        propertyName: "Mom's Rental House"
      };

      const currentMonth = new Date().toISOString().slice(0, 7);
      
      state.tenants = [
        {
          id: 't_1',
          room: 'Room 101 (1st Flr)',
          name: 'Aakash Sharma',
          phone: '9876543210',
          rent: 7500,
          meterReading: 1100,
          startDate: '2026-01-01',
          deposit: 15000
        },
        {
          id: 't_2',
          room: 'Room 102 (1st Flr)',
          name: 'Priya & Ritu',
          phone: '9812345678',
          rent: 8000,
          meterReading: 2350,
          startDate: '2026-02-15',
          deposit: 16000
        },
        {
          id: 't_3',
          room: 'Ground Floor Studio',
          name: 'Vikram Mehta',
          phone: '9988776655',
          rent: 6500,
          meterReading: 820,
          startDate: '2026-03-01',
          deposit: 13000
        }
      ];

      // Sample bills for current month
      state.bills = [
        {
          id: 'b_1',
          tenantId: 't_1',
          month: currentMonth,
          rent: 7500,
          maintenance: 200,
          prevMeter: 1100,
          currMeter: 1195,
          units: 95,
          unitRate: 8,
          electricityTotal: 760,
          grandTotal: 8460,
          status: 'Paid',
          paidDate: new Date().toISOString().split('T')[0],
          paymentMode: 'Google Pay / UPI',
          notes: 'Paid on time'
        },
        {
          id: 'b_2',
          tenantId: 't_2',
          month: currentMonth,
          rent: 8000,
          maintenance: 200,
          prevMeter: 2350,
          currMeter: 2470,
          units: 120,
          unitRate: 8,
          electricityTotal: 960,
          grandTotal: 9160,
          status: 'Pending',
          paidDate: '',
          paymentMode: 'Cash',
          notes: 'Promised to pay by weekend'
        }
      ];

      saveAllToStorage();
    }

    function loadSampleData() {
      showConfirmModal(
        "Load Sample Data?",
        "This will reset records with sample tenants and bills for testing.",
        () => {
          initDefaultSampleData();
          applySettingsToUI();
          populateTenantDropdowns();
          renderDashboard();
          renderHistoryTable();
          renderTenants();
          showToast("Sample data loaded successfully!", "success");
        }
      );
    }

    function switchTab(tabId) {
      state.currentTab = tabId;
      const views = ['dashboard', 'record', 'history', 'tenants', 'settings'];
      
      views.forEach(v => {
        const viewEl = document.getElementById(`view-${v}`);
        const tabEl = document.getElementById(`tab-${v}`);
        if (viewEl) viewEl.classList.toggle('hidden', v !== tabId);
        if (tabEl) {
          if (v === tabId) {
            tabEl.classList.add('active');
            tabEl.classList.remove('text-slate-600', 'hover:bg-slate-100');
          } else {
            tabEl.classList.remove('active');
            tabEl.classList.add('text-slate-600', 'hover:bg-slate-100');
          }
        }
      });

      if (tabId === 'dashboard') renderDashboard();
      if (tabId === 'history') renderHistoryTable();
      if (tabId === 'tenants') renderTenants();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function setDashboardCurrentMonth() {
      const now = new Date();
      const yr = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const val = `${yr}-${m}`;
